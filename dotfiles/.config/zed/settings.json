// Zed settings
// https://zed.dev/docs/configuring-zed
{
  "terminal": {
    "show_count_badge": false,
    "dock": "bottom"
  },
  "show_edit_predictions": false,
  "edit_predictions": {
    "mode": "subtle",
    "provider": "zed"
  },
  "cli_default_open_behavior": "existing_window",
  "agent_ui_font_size": 20.0,
  "buffer_font_weight": 400.0,
  "project_panel": {
    "dock": "left",
  },
  "outline_panel": {
    "dock": "left",
  },
  "collaboration_panel": {
    "dock": "left",
  },
  "agent": {
    "default_model": {
      "provider": "copilot_chat",
      "model": "gpt-5-mini",
      "enable_thinking": true,
      "effort": "high"
    },
    "dock": "right",
    "favorite_models": [],
    "model_parameters": [],
  },
  "git_panel": {
    "dock": "left",
  },
  "inline_code_actions": true,
  "prettier": {
    "parser": "",
    "allowed": true,
  },
  "file_types": {
    "C": [
      "c",
      "h"
    ],
  },
  "languages": {
    "Python": {
      "language_servers": [
        "ty",
        "!basedpyright",
        "ruff"
      ],
      "formatter": "language_server",
      "format_on_save": "on",
    },
    "TypeScript": {
      "formatter": "language_server",
    },
    "JavaScript": {
      "formatter": "language_server",
    },
    "TSX": {
      "formatter": "language_server",
    },
    "HTML": {
      "formatter": "language_server",
    },
    "CSS": {
      "formatter": "language_server",
    },
    "Shell Script": {
      "formatter": {
        "external": {
          "command": "shfmt",
          "arguments": [
            "-i",
            "2",
            "-ci",
            "-bn",
            "-sr",
            "-"
          ],
        },
      },
      "format_on_save": "on",
    },
    "YAML": {
      "formatter": {
        "external": {
          "command": "bunx",
          "arguments": [
            "prettier",
            "--stdin-filepath",
            "{buffer_path}"
          ],
        },
      },
    },
    "JSON": {
      "formatter": "language_server",
    },
    "JSONC": {
      "formatter": "language_server",
    },
    "C": {
      "tab_size": 2,
      "formatter": "language_server",
    },
    "C++": {
      "tab_size": 2,
      "formatter": "language_server",
    },
  },
  "semantic_tokens": "off",
  "document_folding_ranges": "off",
  "document_symbols": "off",
  "indent_guides": {
    "background_coloring": "disabled",
    "coloring": "fixed",
    "active_line_width": 1,
    "line_width": 2,
  },
  "toolbar": {
    "agent_review": true,
    "code_actions": false,
    "breadcrumbs": true,
  },
  "minimap": {
    "current_line_highlight": "all",
    "max_width_columns": 80,
    "thumb_border": "left_open",
    "thumb": "always",
    "display_in": "active_editor",
    "show": "never",
  },
  "relative_line_numbers": "disabled",
  "gutter": {
    "folds": true,
    "min_line_number_digits": 0,
    "runnables": true,
    "line_numbers": true,
  },
  "text_rendering_mode": "platform_default",
  "ui_font_family": "CaskaydiaCove Nerd Font Mono",
  "buffer_line_height": "comfortable",
  "auto_update": false,
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  "scrollbar": {
    "axes": {
      "horizontal": true,
      "vertical": true,
    },
  },
  "buffer_font_fallbacks": [
    "JetBrainsMono Nerd Font"
  ],
  "buffer_font_family": "CaskaydiaCove Nerd Font Mono",
  "agent_servers": {
    "github-copilot-cli": {
      "type": "registry"
    },
    "claude-acp": {
      "default_config_options": {
        "effort": "high",
        "mode": "default",
        "model": "claude-opus-4-8"
      },
      "type": "registry",
    },
  },
  "icon_theme": "Material Icon Theme",
  "base_keymap": "JetBrains",
  "ui_font_size": 20.0,
  "buffer_font_size": 20.0,
  "theme": "Catppuccin Mocha",
}
